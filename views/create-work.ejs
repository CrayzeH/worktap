<%- include('partials/header', { title: title, currentPath: '/seller/works/new' }) %>

<main>
  <div class="container" style="padding: 40px 0 60px;">
    <div class="create-order-card" style="max-width: 900px; margin: 0 auto; background: white; border-radius: 32px; padding: 48px; border: 1px solid #eef2f6;">
      <h1 style="font-size: 32px; margin-bottom: 8px;">Создать ворк</h1>
      <p style="color: #5a6a7e; margin-bottom: 32px;">Опишите готовую услугу, настройте пакеты и опубликуйте ее для заказчиков.</p>

      <div id="errorMessage" style="background: #fee2e2; color: #dc2626; padding: 12px 20px; border-radius: 40px; margin-bottom: 24px; display: none;"></div>

      <form id="createWorkForm">
        <div class="form-group" style="margin-bottom: 20px;">
          <label>Название ворка *</label>
          <input type="text" id="title" required placeholder="Например: Разработаю лендинг под ключ" style="width: 100%; padding: 14px 18px; border-radius: 40px; border: 1.5px solid #e2e8f0;">
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
          <label>Категория *</label>
          <select id="categoryId" class="filter-select" required style="width: 100%; padding: 14px 18px; border-radius: 40px; border: 1.5px solid #e2e8f0;">
            <option value="">Выберите категорию</option>
            <% if (categories && categories.length) { %>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>"><%= cat.name %></option>
              <% }) %>
            <% } %>
          </select>
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
          <label>Описание *</label>
          <textarea id="description" rows="6" required placeholder="Что входит в услугу, какой результат получит заказчик, какие этапы работы..." style="width: 100%; padding: 14px 18px; border-radius: 24px; border: 1.5px solid #e2e8f0; font-family: inherit; resize: vertical;"></textarea>
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
          <label>Что нужно от заказчика</label>
          <textarea id="requirements" rows="4" placeholder="Бриф, материалы, доступы, тексты, примеры..." style="width: 100%; padding: 14px 18px; border-radius: 24px; border: 1.5px solid #e2e8f0; font-family: inherit; resize: vertical;"></textarea>
        </div>

        <div class="form-group" style="margin-bottom: 28px;">
          <label>Картинки ворка</label>
          <textarea id="images" rows="3" placeholder="Вставьте ссылки на изображения, каждую с новой строки" style="width: 100%; padding: 14px 18px; border-radius: 24px; border: 1.5px solid #e2e8f0; font-family: inherit; resize: vertical;"></textarea>
        </div>

        <h3 style="margin-bottom: 16px;">Пакеты</h3>
        <div style="display: grid; gap: 18px;">
          <% [
            {id: 'econom', title: 'Эконом', price: 3000, days: 3},
            {id: 'standard', title: 'Стандарт', price: 7000, days: 5},
            {id: 'business', title: 'Бизнес', price: 15000, days: 10}
          ].forEach(pkg => { %>
            <div style="background: #F7F6FF; border-radius: 24px; padding: 20px;">
              <h4 style="margin-bottom: 14px;"><%= pkg.title %></h4>
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 14px;">
                <div class="form-group">
                  <label>Цена (₽)</label>
                  <input type="number" id="<%= pkg.id %>Price" min="100" value="<%= pkg.price %>" style="width: 100%; padding: 12px 16px; border-radius: 40px; border: 1.5px solid #e2e8f0;">
                </div>
                <div class="form-group">
                  <label>Срок, дней</label>
                  <input type="number" id="<%= pkg.id %>Days" min="1" value="<%= pkg.days %>" style="width: 100%; padding: 12px 16px; border-radius: 40px; border: 1.5px solid #e2e8f0;">
                </div>
              </div>
              <div class="form-group" style="margin-bottom: 14px;">
                <label>Описание пакета</label>
                <input type="text" id="<%= pkg.id %>Description" placeholder="Кратко опишите состав пакета" style="width: 100%; padding: 12px 16px; border-radius: 40px; border: 1.5px solid #e2e8f0;">
              </div>
              <div class="form-group">
                <label>Что входит</label>
                <textarea id="<%= pkg.id %>Features" rows="3" placeholder="Каждый пункт с новой строки" style="width: 100%; padding: 12px 16px; border-radius: 20px; border: 1.5px solid #e2e8f0; font-family: inherit;"></textarea>
              </div>
            </div>
          <% }) %>
        </div>

        <button type="submit" class="btn-green" style="width: 100%; padding: 14px; font-size: 16px; margin-top: 28px;">Опубликовать ворк</button>
      </form>
    </div>
  </div>
</main>

<script>
  const form = document.getElementById('createWorkForm');
  const errorDiv = document.getElementById('errorMessage');

  function packageData(name) {
    return {
      name,
      price: Number(document.getElementById(`${name}Price`).value),
      delivery_days: Number(document.getElementById(`${name}Days`).value),
      description: document.getElementById(`${name}Description`).value,
      features: document.getElementById(`${name}Features`).value
    };
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    const formData = {
      title: document.getElementById('title').value.trim(),
      category_id: document.getElementById('categoryId').value,
      description: document.getElementById('description').value.trim(),
      requirements: document.getElementById('requirements').value.trim(),
      images: document.getElementById('images').value,
      packages: ['econom', 'standard', 'business'].map(packageData)
    };

    if (!formData.title || !formData.category_id || !formData.description) {
      errorDiv.textContent = 'Заполните название, категорию и описание';
      errorDiv.style.display = 'block';
      return;
    }

    const submitBtn = form.querySelector('button[type="submit"]');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Публикация...';
    errorDiv.style.display = 'none';

    try {
      const response = await fetch('/api/works', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify(formData)
      });
      const data = await response.json();

      if (data.success) {
        window.location.href = `/work/${data.workId}`;
      } else {
        errorDiv.textContent = data.error || 'Не удалось создать ворк';
        errorDiv.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Опубликовать ворк';
      }
    } catch (err) {
      errorDiv.textContent = 'Ошибка соединения с сервером';
      errorDiv.style.display = 'block';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Опубликовать ворк';
    }
  });
</script>

<%- include('partials/footer') %>
