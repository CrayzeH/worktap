NODE_ENV=production

# Optional writable storage root. If omitted, the app tries:
# STORAGE_ROOT / DATA_DIR / WORKTAP_DATA_DIR / .data / system temp.
STORAGE_ROOT=.data

# Optional explicit SQLite path.
DB_STORAGE=.data/worktap.db

# Optional explicit upload directory. Files stay available by /uploads/... URLs.
UPLOAD_ROOT=.data/uploads
